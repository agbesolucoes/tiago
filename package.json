{
  "name": "central-organizacao",
  "version": "1.0.0",
  "scripts": {
    "dev": "vite",
    "test": "vitest run && vitest run -c vitest.node.config.ts",
    "typecheck": "tsc -p . && tsc -p tsconfig.web.json && tsc -p tsconfig.node.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "deploy": "vite build && wrangler d1 migrations apply DB --remote && wrangler deploy",
    "build": "vite build && npm run build:server",
    "preview": "vite preview",
    "build:server": "node scripts/build-server.mjs",
    "start": "node dist/server/index.mjs",
    "test:node": "vitest run -c vitest.node.config.ts",
    "analista:atualizar": "node scripts/atualizar-analista.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.12",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "rrule": "^2.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.2",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260930.2",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^4.1.11",
    "wrangler": "^4.144.0"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "esbuild@0.28.2": true,
    "workerd@1.20260815.1": true,
    "workerd@1.20260926.1": true
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  }
}
