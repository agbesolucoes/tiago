{
  "name": "central-organizacao",
  "version": "1.0.0",
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "typecheck": "tsc -p . && tsc -p tsconfig.web.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "deploy": "vite build && wrangler d1 migrations apply DB --remote && wrangler deploy",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.12",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.2",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260930.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^4.1.11",
    "wrangler": "^4.144.0"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "workerd@1.20260815.1": true,
    "workerd@1.20260926.1": true
  },
  "private": true,
  "type": "module"
}
